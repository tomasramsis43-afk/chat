# ===== App =====
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# اختياري: يُستخدم لحماية CORS/CSRF عبر نطاقات منفصلة.
# للـ same-origin (مثل Render) لا حاجة له — فحص Origin يعتمد على Host تلقائيًا.
# APP_URL=https://salem.example.com

# ===== Auth =====
# مطلوب في الإنتاج: قيمة عشوائية من 32 حرفًا على الأقل
# أنشئها مثلًا بـ:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ===== Admin (اختياري) =====
# أسماء مستخدمين (فاصلة بينها كوما) بتترقّى لـ admin تلقائيًا عند التسجيل بيها.
# لترقية مستخدم موجود بالفعل استخدم: node scripts/promote-admin.js <username>
# ADMIN_USERNAMES=tomas

# ===== Google Sign-In (اختياري) =====
# من Google Cloud Console → OAuth consent screen ← Credentials → OAuth Client ID (Web application)
# اضبط Authorized redirect URI على: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Database =====
# اضبطه للـ PostgreSQL (Neon / Render / Supabase) — إن تُرك فارغًا تستخدم SQLite
DATABASE_URL=
# مسار ملف SQLite المحلي (اختياري، الافتراضي data/chat.db)
# DB_FILE=./data/chat.db
# وضع SSL للقاعدة: disabled | require | verify-full (الافتراضي: require في الإنتاج)
# DB_SSL=require
# إعدادات pool PostgreSQL (اختياري)
# PG_POOL_MAX=10
# PG_STATEMENT_TIMEOUT_MS=0

# ===== CORS =====
# Origins إضافية مفصولة بفواصل (غير مطلوبة عادةً في الإنتاج)
# CORS_ORIGINS=https://app.example.com

# ===== Rate limits (اختياري) =====
# RATE_API=300
# RATE_AUTH=10
# RATE_AUTH_USER=5
# MSG_MAX_LEN=4000
# UPLOAD_MAX_BYTES=5242880
# UPLOAD_MAX_BASE64=7mb
# SOCKET_MAX_PER_USER=8
# SOCKET_MAX_PER_IP=20
# MSG_RATE_BURST=10
# MSG_RATE_PER_SEC=5

# ===== Proxy / Cookies =====
# فعّل لو كان هناك reverse proxy (Render/Railway/Nginx)
# TRUST_PROXY=true
# COOKIE_SECURE=true

# ===== Logging =====
# LOG_LEVEL=info          # error | warn | info | http | debug
# LOG_JSON=true           # JSON مخصّص للسحب إلى أدوات (Loki/ELK/…)

# ===== Storage (رفع الملفات) =====
# provider: local | s3 (الافتراضي local)
# STORAGE_PROVIDER=local
# UPLOAD_DIR=./data/uploads
# عند استخدام S3 (يقلل الحجم والتكلفة من الخادم ويوسّع التخزين):
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://<bucket>.s3.<region>.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ===== Server lifecycle =====
# SHUTDOWN_TIMEOUT_MS=10000

# ===== Redis (اختياري — للـ multi-instance لاحقًا فقط) =====
# يُستخدم عند تشغيل أكثر من instance لتوزيع الحضور ورفع حدود الإرسال.
# لا حاجة له في الخادم الواحد.
# REDIS_URL=redis://localhost:6379