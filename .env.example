# ===== App =====
NODE_ENV=production
PORT=3000
# الرابط النهائي للتطبيق (يُستخدم لفحص Origin وCORS)
APP_URL=https://salem.example.com

# ===== Auth =====
# مطلوب في الإنتاج: قيمة عشوائية من 32 حرفًا على الأقل
# أنشئها مثلًا بـ:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ===== Database =====
# اضبطه للـ PostgreSQL (Neon / Render / Supabase) — إن تُرك فارغًا تستخدم SQLite
DATABASE_URL=
# مسار ملف SQLite المحلي (اختياري، الافتراضي data/chat.db)
# DB_FILE=./data/chat.db

# ===== CORS =====
# Origins إضافية مفصولة بفواصل (غير مطلوبة عادةً في الإنتاج)
# CORS_ORIGINS=https://app.example.com

# ===== Rate limits (اختياري) =====
# RATE_API=300
# RATE_AUTH=10
# RATE_AUTH_USER=5
# MSG_MAX_LEN=4000

# ===== Proxy / Cookies =====
# فعّل لو كان هناك reverse proxy (Render/Railway/Nginx)
# TRUST_PROXY=true
# COOKIE_SECURE=true